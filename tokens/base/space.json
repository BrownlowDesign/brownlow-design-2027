{
  "space": {
    "$type": "dimension",
    "$description": "4px base, 8px primary rhythm. DESIGN.md: 'all spacing from an 8px scale' — use even steps (2,4,6,8…) for layout; odd steps (1,3) for tight internal padding only.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "20px" },
    "full": { "$value": "9999px" }
  }
}
