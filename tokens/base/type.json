{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "PLACEHOLDER" },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "PLACEHOLDER" }
    },
    "size": {
