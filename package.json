{
  "name": "brownlow-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm tokens:build && next dev",
    "build": "pnpm tokens:build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node tokens/build.mjs",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "verify": "node scripts/verify.mjs",
    "snap": "node scripts/snap.mjs",
    "perf": "node scripts/perf.mjs",
    "shaders": "node scripts/shader-check.mjs",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:docker": "bash scripts/visual-docker.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.177.0",
    "zod": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "esbuild",
      "style-dictionary",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.177.0",
    "dependency-cruiser": "^16",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "style-dictionary": "^4",
    "stylelint": "^16",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^3",
    "yaml": "^2"
  }
}
