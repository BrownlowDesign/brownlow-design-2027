{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm snap:*)",
      "Bash(pnpm perf:*)",
      "Bash(pnpm shaders:*)",
      "Bash(pnpm tokens:build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm visual)",
      "Bash(pnpm visual:docker)",
      "Bash(pnpm exec playwright install:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git stash:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm visual:update:*)",
      "Bash(pnpm visual:docker --update-snapshots:*)",
      "Bash(pnpm exec playwright test --update-snapshots:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Edit(CLAUDE.md)",
      "Edit(docs/DESIGN.md)",
      "Edit(docs/STORY.md)",
      "Edit(docs/budgets.json)",
      "Edit(scripts/**)",
      "Edit(.claude/**)",
      "Edit(tasks/*.yaml)"
    ],
    "deny": [
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel promote:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(tests/visual/__screenshots__/**)",
      "Write(tests/visual/__screenshots__/**)",
      "Edit(src/tokens/generated/**)",
      "Edit(src/styles/generated/**)",
      "Edit(src/gl/glsl/generated/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.mjs",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-gate.mjs",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
